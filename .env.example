# 复制为 .env 后按需修改（docker compose 会自动读取同目录 .env）
# cp .env.example .env

# ---- 对外端口 ----
# 宿主机映射端口，访问 http://localhost:8080
# 注意：改这个值时需要同步修改 docker-compose.yml 的 ports 映射

# ---- 语音转录 (STT) ----
# 硅基流动 API Token。留空则使用代码内置的默认 Token（可能已失效或触发实名校验）
# 申请地址：https://cloud.siliconflow.cn/account/ak
SILICONFLOW_TOKEN=

# 转录模型与接口地址（一般无需修改）
SILICONFLOW_MODEL=FunAudioLLM/SenseVoiceSmall
SILICONFLOW_API_URL=https://api.siliconflow.cn/v1/audio/transcriptions

# ---- 文字转语音 (TTS) 长文本限制 ----
# 单次合成允许的最大分块数。容器环境不受 Workers 子请求数限制，可比默认 40 更大
MAX_CHUNKS=80
# 上传 txt 文件时允许的最大字符数
MAX_TEXT_LENGTH=10000

# ---- 请求体上限（字节）----
# 转录音频最大 10MB，multipart 编码后更大，默认 20MB
MAX_BODY_BYTES=20971520
